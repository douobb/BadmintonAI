# BadmintonAI v2 公開、非秘密設定範例。
# API key、密碼等秘密只放在本機 .env；該檔已排除版本控制，請勿提交。

# 可用值：development、test、staging、production
BADMINTON_AI_APP_ENV=development

# 預先準備且由產品程序以唯讀語意使用的資料目錄。
BADMINTON_AI_SOURCE_DATA_DIR=data

# 由應用程式明確建立並寫入的 runtime 目錄。
BADMINTON_AI_RUNTIME_DIR=.runtime

# Tool Server 讀取的核准資料檔；相對路徑只能位於 source data 目錄內。
# 副檔名可為 CSV、DB、SQLite 或 SQLite3；SQLite 預設 table 為 match_data。
BADMINTON_AI_DATA_FILE=processed_new_3.csv
BADMINTON_AI_METADATA_DIR=metadata
BADMINTON_AI_SQLITE_TABLE=match_data

# 可選：sandbox image。留空時使用程式內 pinned GHCR digest。
# 獨立 render 工具需新版 bootstrap；公開 digest 更新前，請依 docs/first-setup.md
# 從 sandbox/Dockerfile 建置固定本機 image，再將此值設為該 tag。
BADMINTON_AI_SANDBOX_IMAGE=

# Compose 設定（均非秘密值）。
# Tool Server 主機連接埠固定只發布到 127.0.0.1；Open WebUI 固定使用 8080。
OPEN_WEBUI_HOST_PORT=3000
BADMINTON_AI_TOOL_SERVER_HOST_PORT=8000

# 唯讀掛載到 Open WebUI 的單一核准題檔；專案附帶原始 100 題。
BADMINTON_AI_EVALUATION_QUESTIONS_HOST_FILE=./evaluation/questions/評估問題_v2.txt

# Open WebUI aiohttp 模型上游 timeout（秒）；官方設定會套用於全域上游連線。
# 總時間 1200 秒可涵蓋已知約 16 分鐘的長題；串流連續閒置 120 秒才逾時。
BADMINTON_AI_EVALUATION_UPSTREAM_TIMEOUT_SECONDS=1200
BADMINTON_AI_EVALUATION_STREAM_IDLE_TIMEOUT_SECONDS=120
# 僅列出的模型 ID 與評測回合套用的單次串流防護；預設 BadmintonAI 180/60/90 秒。
BADMINTON_AI_STREAM_MODEL_IDS=badmintonai
BADMINTON_AI_STREAM_TOTAL_SECONDS=180
BADMINTON_AI_STREAM_NO_DATA_SECONDS=60
BADMINTON_AI_STREAM_NO_PROGRESS_SECONDS=90
# 評測 adapter 對整輪等待上游與聊天持久化讀回的額外緩衝（秒）。
# adapter 上限 = AIOHTTP_CLIENT_TIMEOUT + 此緩衝；多工具長回合可適度增加。
BADMINTON_AI_EVALUATION_ADAPTER_WAIT_GRACE_SECONDS=30

# 使用評測工作台或聊天室圖表附件時，請在本機 .env 設定此 Open WebUI API key。
# 僅供 server-side 呼叫；勿填入此範例檔、提交至版本控制，或暴露給瀏覽器。
# BADMINTON_AI_OPEN_WEBUI_API_KEY=

# Compose 將這個主機資料夾以唯讀方式掛載到 Tool Server；預設使用專案附帶的資料與 metadata。
BADMINTON_AI_SOURCE_DATA_HOST_DIR=./data

# 這是秘密檔案的路徑，不是秘密內容；請自行建立並持久保存該檔案。
# compose.yaml 會在缺少此設定時明確失敗；啟動時也會要求檔案存在。
WEBUI_SECRET_KEY_FILE=.secrets/webui_secret_key
